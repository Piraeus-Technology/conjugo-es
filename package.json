{
  "name": "spanish-conjugation",
  "version": "1.3.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "coverage": "jest --selectProjects logic --coverage --coverageDirectory=coverage/logic --coverageReporters=json --runInBand && jest --selectProjects ui --coverage --coverageDirectory=coverage/ui --coverageReporters=json --runInBand && node scripts/report-coverage.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "audit:examples": "node scripts/audit-example-mismatches.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "expo": "^58.1.0",
    "expo-asset": "~58.0.21",
    "expo-dev-client": "~58.0.22",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-iap": "6.6.0",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.15",
    "expo-store-review": "~58.0.3",
    "fuse.js": "^7.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.11"
  },
  "private": true,
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "react-test-renderer": "19.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}

    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "jest": "^30.3.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"

    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "expo": "^55.0.32",
    "expo-asset": "~55.0.20",
    "expo-build-properties": "~55.0.18",
    "expo-dev-client": "~55.0.41",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
